---
import Layout from '../layouts/Layout.astro';
import { GAS_URL } from '../consts';
import { getQuiz } from '../lib/notion';

const base = import.meta.env.BASE_URL;
const memberUrl = `${base.replace(/\/$/, '')}/member`;
const quizData = await getQuiz();
---

<Layout
  title="占いクイズ｜Fortune Labo"
  description="占い師の基礎や占術別の知識を毎週チャレンジ。正答率スコアが記録され、合格すると称号がもらえます。"
>
  <section class="section">
    <div class="container narrow">
      <h1 class="section-title">占いクイズ</h1>
      <p class="section-lead">
        占術別に毎週チャレンジ。正答率が記録され、<strong>80%以上で「今週の合格」</strong>の称号がもらえます。
      </p>

      <!-- 未ログイン -->
      <div id="needLogin" class="panel" hidden>
        <p>クイズは会員専用です。まず会員ページでログインしてください。</p>
        <a class="btn btn-primary" href={memberUrl}>会員ページでログイン →</a>
      </div>

      <!-- 今週のスコア -->
      <div id="scoreBox" class="score-box" hidden>
        <p class="score-title">今週のスコア</p>
        <div id="scoreList" class="score-list"></div>
      </div>

      <!-- 占術選択 -->
      <div id="quizMain" hidden>
        {
          quizData.length === 0 ? (
            <p class="empty">クイズは準備中です。</p>
          ) : (
            <>
              <p class="pick-lead">挑戦する占術を選んでください。</p>
              <div class="art-picker" id="artPicker">
                {quizData.map((qa) => (
                  <button class="chip" type="button" data-art={qa.art}>
                    {qa.art}（{qa.questions.length}問）
                  </button>
                ))}
              </div>
            </>
          )
        }
        <div id="quizArea"></div>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ GAS_URL, quizData }} is:inline>
  const esc = (s) =>
    String(s == null ? '' : s).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const needLogin = document.getElementById('needLogin');
  const quizMain = document.getElementById('quizMain');
  const scoreBox = document.getElementById('scoreBox');
  const scoreList = document.getElementById('scoreList');
  const artPicker = document.getElementById('artPicker');
  const quizArea = document.getElementById('quizArea');

  let creds = null;
  try { const s = sessionStorage.getItem('fl_cred'); if (s) creds = JSON.parse(s); } catch (e) {}

  if (!creds) {
    needLogin.hidden = false;
  } else {
    quizMain.hidden = false;
    loadScores();
  }

  const byArt = {};
  (quizData || []).forEach((qa) => (byArt[qa.art] = qa.questions));

  async function postGas(payload) {
    const res = await fetch(GAS_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload),
    });
    return res.json();
  }

  async function loadScores() {
    try {
      const d = await postGas({ action: 'member_login', memberNo: creds.no, pin: creds.pin });
      if (d.status !== 'ok') return;
      const scores = d.quizScores || [];
      if (!scores.length) { scoreBox.hidden = true; return; }
      scoreBox.hidden = false;
      scoreList.innerHTML = scores.map((s) =>
        `<span class="score-chip ${s.passed ? 'passed' : ''}">${esc(s.art)} ${esc(s.rate)}%`
        + `${s.passed ? ' 🎓' : ''}</span>`).join('');
    } catch (e) {}
  }

  // ===== 1問ずつ出題 → 最後にまとめて採点 =====
  const QUIZ_MAX = 10; // 1回の出題数
  let quizArt = '';
  let shown = [];      // 出題中の問題
  let idx = 0;         // 現在の問題番号
  const answers = {};  // qId -> '1'..'4'
  function shuffle(a) {
    const b = a.slice();
    for (let i = b.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [b[i], b[j]] = [b[j], b[i]]; }
    return b;
  }

  if (artPicker) {
    artPicker.addEventListener('click', (e) => {
      const btn = e.target.closest('.chip');
      if (!btn) return;
      Array.from(artPicker.querySelectorAll('.chip')).forEach((c) => c.classList.toggle('is-active', c === btn));
      startQuiz(btn.dataset.art);
    });
  }

  function startQuiz(art) {
    quizArt = art;
    const all = byArt[art] || [];
    shown = shuffle(all).slice(0, QUIZ_MAX);
    idx = 0;
    Object.keys(answers).forEach((k) => delete answers[k]);
    renderCard();
  }

  function renderCard() {
    const total = shown.length;
    const q = shown[idx];
    const pct = Math.round(((idx + 1) / total) * 100);
    const opts = q.choices.map((c, ci) => {
      const v = String(ci + 1);
      const sel = answers[q.id] === v;
      return `<button class="choice-btn ${sel ? 'sel' : ''}" type="button" data-v="${v}">`
        + `<span class="choice-number">${v}</span><span class="choice-text">${esc(c)}</span></button>`;
    }).join('');
    const backBtn = idx > 0 ? `<button class="btn btn-ghost q-prev" type="button">← 前の問題</button>` : '';
    quizArea.innerHTML =
      `<div class="quiz-card">`
      + `<div class="quiz-top"><span class="quiz-count">Q${idx + 1} / ${total}</span><span class="quiz-artname">${esc(quizArt)}</span></div>`
      + `<div class="quiz-bar"><span style="width:${pct}%"></span></div>`
      + `<p class="quiz-q">${esc(q.q)}</p>`
      + `<div class="quiz-opts">${opts}</div>`
      + `<div class="quiz-nav">${backBtn}</div>`
      + `<p class="grade-msg" id="gradeMsg" aria-live="polite"></p>`
      + `</div>`;
    quizArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  let advancing = false;
  async function gradeAll() {
    const m = document.getElementById('gradeMsg'); if (m) { m.textContent = '採点中…'; m.className = 'grade-msg'; }
    try {
      const r = await postGas({ action: 'quiz_grade', memberNo: creds.no, pin: creds.pin, art: quizArt, answers });
      if (r.status !== 'ok') { if (m) { m.textContent = r.message || '採点できませんでした。'; m.className = 'grade-msg error'; } return; }
      renderResult(r); loadScores();
    } catch (err) { if (m) { m.textContent = '通信に失敗しました。'; m.className = 'grade-msg error'; } }
  }

  // 選択したら自動で次へ（最後の問題は自動で採点）
  quizArea.addEventListener('click', (e) => {
    const choice = e.target.closest('.choice-btn');
    if (choice) {
      if (advancing) return;
      answers[shown[idx].id] = choice.dataset.v;
      quizArea.querySelectorAll('.choice-btn').forEach((b) => b.classList.toggle('sel', b === choice));
      advancing = true;
      setTimeout(() => {
        advancing = false;
        if (idx < shown.length - 1) { idx++; renderCard(); }
        else { gradeAll(); }
      }, 260);
      return;
    }
    if (e.target.closest('.q-prev')) { if (idx > 0) { idx--; renderCard(); } return; }
    const again = e.target.closest('.quiz-again');
    if (again) { startQuiz(again.dataset.art); }
  });

  function renderResult(r) {
    const byId = {}; (r.results || []).forEach((x) => (byId[x.id] = x));
    const rank = r.passed ? '🎓 今週の合格！' : '';
    const review = shown.map((q, i) => {
      const res = byId[q.id]; if (!res) return '';
      const ansText = q.choices[Number(res.answer) - 1] || res.answer;
      return `<div class="rv ${res.correct ? 'ok' : 'ng'}"><p class="rv-q">Q${i + 1}. ${esc(q.q)}</p>`
        + `<p class="rv-a">${res.correct ? '⭕ 正解' : '❌ 不正解'}（正解：${esc(ansText)}）</p>`
        + (res.explain ? `<p class="rv-e">${esc(res.explain)}</p>` : '') + `</div>`;
    }).join('');
    quizArea.innerHTML =
      `<div class="quiz-result">`
      + `<div class="score-final ${r.passed ? 'passed' : ''}">正答 ${r.correct} / ${r.total}　正答率 <strong>${r.rate}%</strong> ${rank}</div>`
      + `<h3 class="rv-h">解説</h3>${review}`
      + `<button class="btn btn-primary btn-block quiz-again" data-art="${esc(quizArt)}">別の問題に挑戦する</button>`
      + `</div>`;
    quizArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
</script>

<style>
  .narrow { max-width: 680px; }
  .empty { color: var(--color-text-muted); text-align: center; }
  .panel {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius); padding: 1.8rem; text-align: center;
  }
  .panel p { color: var(--color-text-muted); margin-bottom: 1.2rem; }

  .score-box {
    background: var(--color-bg-soft); border: 1px solid var(--color-border);
    border-radius: var(--radius); padding: 1.1rem 1.3rem; margin-bottom: 1.8rem;
  }
  .score-title { font-weight: 800; font-size: 0.9rem; color: var(--color-primary-soft); margin-bottom: 0.6rem; }
  .score-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .score-chip {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.82rem; font-weight: 700;
  }
  .score-chip.passed { border-color: var(--color-accent); color: var(--color-accent-soft); }

  .pick-lead { color: var(--color-text-muted); margin-bottom: 0.8rem; }
  .art-picker { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.5rem; }
  .chip {
    border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-text-muted); border-radius: 999px; padding: 0.45rem 1.05rem;
    font-size: 0.88rem; font-weight: 700; cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .chip:hover { border-color: var(--color-primary); color: var(--color-primary-soft); }
  .chip.is-active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }

  /* 1問カード */
  .quiz-card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 16px; padding: 1.4rem 1.4rem 1.2rem; margin-top: 1rem;
    box-shadow: 0 8px 26px rgba(26, 36, 64, 0.08);
  }
  .quiz-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem; }
  .quiz-count { font-weight: 800; color: var(--color-primary-soft); font-size: 0.95rem; }
  .quiz-artname { font-size: 0.8rem; color: var(--color-text-muted); }
  .quiz-bar { height: 6px; border-radius: 999px; background: var(--color-border); overflow: hidden; margin-bottom: 1.2rem; }
  .quiz-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--color-primary-soft), var(--color-primary)); transition: width 0.25s ease; }
  .quiz-q { font-size: 1.15rem; font-weight: 700; line-height: 1.7; margin-bottom: 1.1rem; }
  .quiz-opts { display: grid; gap: 0.7rem; }
  .choice-btn {
    display: flex; gap: 0.9rem; align-items: center; text-align: left; width: 100%;
    padding: 0.95rem 1.1rem; border: 2px solid var(--color-border); border-radius: 12px;
    background: var(--color-bg-soft); color: var(--color-text);
    cursor: pointer; font-size: 1.02rem; line-height: 1.6; font-family: inherit;
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
  }
  .choice-btn:hover { border-color: var(--color-primary); }
  .choice-btn:active { transform: scale(0.99); }
  .choice-btn.sel { border-color: var(--color-primary); background: rgba(46, 74, 138, 0.1); color: var(--color-primary-soft); font-weight: 700; }
  .choice-number {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--color-surface); border: 2px solid currentColor;
    font-size: 0.9rem; font-weight: 800;
  }
  .choice-text { flex: 1; }
  .quiz-nav { display: flex; justify-content: flex-start; margin-top: 1.2rem; min-height: 1px; }
  .quiz-nav .btn { font-size: 0.85rem; padding: 0.4rem 1rem; }
  .grade-msg { text-align: center; font-size: 0.88rem; min-height: 1em; margin-top: 0.6rem; }
  .grade-msg.error { color: #d33; }
  .btn-block { width: 100%; margin-top: 0.5rem; }

  /* 結果 */
  .quiz-result { margin-top: 1rem; }
  .score-final {
    text-align: center; padding: 1.2rem;
    background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: 14px;
    font-size: 1.05rem; margin-bottom: 1.4rem;
  }
  .score-final strong { color: var(--color-primary-soft); font-size: 1.5rem; }
  .score-final.passed { border-color: var(--color-accent); }
  .rv-h { font-size: 1.05rem; color: var(--color-primary-soft); margin: 0.5rem 0 0.8rem; }
  .rv {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-border); border-radius: 12px; padding: 0.9rem 1.1rem; margin-bottom: 0.7rem;
  }
  .rv.ok { border-left-color: #06a047; }
  .rv.ng { border-left-color: #d33; }
  .rv-q { font-weight: 700; line-height: 1.6; }
  .rv-a { font-size: 0.9rem; font-weight: 700; margin-top: 0.4rem; }
  .rv.ok .rv-a { color: #06a047; }
  .rv.ng .rv-a { color: #d33; }
  .rv-e { color: var(--color-text-muted); font-size: 0.88rem; line-height: 1.8; margin-top: 0.4rem; }
</style>
