---
import Layout from '../layouts/Layout.astro';
import { GAS_URL } from '../consts';
---

<Layout
  title="会員ページ｜Fortune Labo"
  description="Fortune Labo 会員専用ページ。会員番号と暗証番号でログインし、あなたのスコア・評定・受講状況を確認できます。"
>
  <section class="section">
    <div class="container narrow">
      <h1 class="section-title">会員ページ</h1>

      <!-- ログイン -->
      <div id="login" class="panel">
        <p class="login-lead">
          会員番号と暗証番号（4桁）でログインしてください。<br />
          暗証番号は運営からご案内した番号です。
        </p>
        <form id="login-form" class="login-form" novalidate>
          <label class="field">
            <span class="field-label">会員番号</span>
            <input id="memberNo" type="text" inputmode="text" autocomplete="off"
              placeholder="例：BR-001" required />
          </label>
          <label class="field">
            <span class="field-label">暗証番号（4桁）</span>
            <input id="pin" type="password" inputmode="numeric" autocomplete="off"
              maxlength="4" pattern="[0-9]*" placeholder="••••" required />
          </label>
          <button id="login-btn" type="submit" class="btn btn-primary btn-block">ログイン</button>
          <p id="login-msg" class="login-msg" role="alert" aria-live="polite"></p>
        </form>
        <p class="login-note">
          暗証番号がわからない場合や、うまくログインできない場合は
          公式LINEからお問い合わせください。
        </p>
      </div>

      <!-- ダッシュボード -->
      <div id="dash" hidden></div>
    </div>
  </section>
</Layout>

<script define:vars={{ GAS_URL }} is:inline>
  const loginBox = document.getElementById('login');
  const dash = document.getElementById('dash');
  const form = document.getElementById('login-form');
  const msg = document.getElementById('login-msg');
  const btn = document.getElementById('login-btn');
  const noEl = document.getElementById('memberNo');
  const pinEl = document.getElementById('pin');

  const esc = (s) =>
    String(s == null ? '' : s).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])
    );
  const chips = (arr, cls) =>
    (arr && arr.length)
      ? arr.map((x) => `<span class="chip ${cls}">${esc(x)}</span>`).join('')
      : '<span class="chip-empty">まだありません</span>';

  // ── 鑑定ロープレ評価（パラメータ表示） ──
  const EVAL_ITEMS = ['声・話し方', '聞く姿勢', '言葉選び', '鑑定の流れ', '鑑定内容', '安心感'];

  function radarSVG(scores) {
    const cx = 160, cy = 152, R = 92, N = 6, MAX = 5;
    const ang = (i) => (-90 + i * (360 / N)) * Math.PI / 180;
    const pt = (i, r) => [cx + r * Math.cos(ang(i)), cy + r * Math.sin(ang(i))];
    let grid = '';
    for (let g = 1; g <= MAX; g++) {
      const r = (R * g) / MAX;
      const pts = EVAL_ITEMS.map((_, i) => pt(i, r).map((v) => v.toFixed(1)).join(',')).join(' ');
      grid += `<polygon points="${pts}" class="rad-grid"/>`;
    }
    let axes = '';
    EVAL_ITEMS.forEach((_, i) => { const [x, y] = pt(i, R); axes += `<line x1="${cx}" y1="${cy}" x2="${x.toFixed(1)}" y2="${y.toFixed(1)}" class="rad-axis"/>`; });
    const dpts = EVAL_ITEMS.map((k, i) => { const v = Math.max(0, Math.min(MAX, scores[k] || 0)); return pt(i, (R * v) / MAX).map((n) => n.toFixed(1)).join(','); }).join(' ');
    let dots = '', labels = '';
    EVAL_ITEMS.forEach((k, i) => {
      const v = Math.max(0, Math.min(MAX, scores[k] || 0));
      const [dx, dy] = pt(i, (R * v) / MAX);
      dots += `<circle cx="${dx.toFixed(1)}" cy="${dy.toFixed(1)}" r="3.2" class="rad-dot"/>`;
      const [lx, ly] = pt(i, R + 15);
      let anchor = 'middle'; if (lx > cx + 5) anchor = 'start'; else if (lx < cx - 5) anchor = 'end';
      labels += `<text x="${lx.toFixed(1)}" y="${(ly + 4).toFixed(1)}" text-anchor="${anchor}" class="rad-label">${esc(k)}</text>`;
    });
    return `<svg viewBox="0 0 320 300" class="radar" role="img" aria-label="鑑定ロープレ評価レーダー">${grid}${axes}<polygon points="${dpts}" class="rad-area"/>${dots}${labels}</svg>`;
  }

  function evalBars(scores) {
    return EVAL_ITEMS.map((k) => {
      const v = scores[k];
      const pct = v != null ? (v / 5) * 100 : 0;
      return `<div class="ev-row"><span class="ev-name">${esc(k)}</span><span class="ev-bar"><span class="ev-fill" style="width:${pct}%"></span></span><span class="ev-num">${v != null ? esc(v) : '—'}</span></div>`;
    }).join('');
  }

  function evalSection(ev) {
    if (!ev || !ev.scores) return '';
    const vals = EVAL_ITEMS.map((k) => ev.scores[k]).filter((v) => v != null);
    if (!vals.length) return '';
    const avg = vals.reduce((a, b) => a + b, 0) / vals.length;
    const meta = [ev.date ? `評価日：${esc(ev.date)}` : '', ev.evaluator ? `評価者：${esc(ev.evaluator)}` : ''].filter(Boolean).join(' ／ ');
    const comment = ev.comment
      ? `<div class="eval-comment"><p class="ev-c-label">総合コメント</p><p>${esc(ev.comment)}</p></div>` : '';
    return `
      <div class="block eval-block">
        <h2 class="block-h">鑑定ロープレ評価</h2>
        ${meta ? `<p class="eval-meta">${meta}</p>` : ''}
        <div class="eval-wrap">
          <div class="eval-radar">${radarSVG(ev.scores)}<p class="eval-avg">平均 <strong>${avg.toFixed(1)}</strong> / 5</p></div>
          <div class="eval-bars">${evalBars(ev.scores)}</div>
        </div>
        ${comment}
      </div>`;
  }

  function renderDash(d) {
    loginBox.hidden = true;
    dash.hidden = false;
    const teller = d.tellerName ? `<span class="teller">占い師名：${esc(d.tellerName)}</span>` : '';
    const courses = (d.courses && d.courses.length)
      ? `<ul class="course-list">${d.courses.map((c) => `<li>${esc(c)}</li>`).join('')}</ul>`
      : '<p class="chip-empty">受講講座はまだ記録されていません。</p>';
    dash.innerHTML = `
      <div class="dash-head">
        <div>
          <p class="dash-hello">ようこそ、<strong>${esc(d.name || '会員')}</strong> さん</p>
          <p class="dash-sub">${esc(d.memberNo || '')} ${d.memberStatus ? '／ ' + esc(d.memberStatus) : ''} ${teller}</p>
        </div>
        <button id="logout" class="btn btn-ghost btn-sm">ログアウト</button>
      </div>

      <div class="score-grid">
        <div class="score-card">
          <p class="score-label">今期得点</p>
          <p class="score-value">${d.thisTerm != null ? esc(d.thisTerm) : '—'}<span class="score-unit">点</span></p>
        </div>
        <div class="score-card accent">
          <p class="score-label">通算得点</p>
          <p class="score-value">${d.total != null ? esc(d.total) : '—'}<span class="score-unit">点</span></p>
        </div>
      </div>

      ${evalSection(d.evaluation)}

      <div class="block">
        <h2 class="block-h">称号</h2>
        <div class="chip-row">${chips(d.titles, 'chip-title')}</div>
      </div>
      <div class="block">
        <h2 class="block-h">認定・テスト</h2>
        <div class="chip-row">${chips(d.certs, 'chip-cert')}</div>
      </div>
      <div class="block">
        <h2 class="block-h">受講した講座</h2>
        ${courses}
      </div>
    `;
    document.getElementById('logout').addEventListener('click', () => {
      try { sessionStorage.removeItem('fl_member'); } catch (e) {}
      dash.hidden = true;
      loginBox.hidden = false;
      form.reset();
      msg.textContent = '';
    });
    dash.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function login(memberNo, pin) {
    btn.disabled = true;
    btn.textContent = 'ログイン中…';
    msg.textContent = '';
    msg.className = 'login-msg';
    try {
      const res = await fetch(GAS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ action: 'member_login', memberNo, pin }),
      });
      const data = await res.json();
      if (data.status === 'ok') {
        try { sessionStorage.setItem('fl_member', JSON.stringify(data)); } catch (e) {}
        renderDash(data);
      } else {
        msg.textContent = data.message || 'ログインできませんでした。';
        msg.className = 'login-msg error';
      }
    } catch (e) {
      msg.textContent = '通信に失敗しました。時間をおいて再度お試しください。';
      msg.className = 'login-msg error';
    } finally {
      btn.disabled = false;
      btn.textContent = 'ログイン';
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const no = noEl.value.trim();
    const pin = pinEl.value.trim();
    if (!no || !pin) {
      msg.textContent = '会員番号と暗証番号を入力してください。';
      msg.className = 'login-msg error';
      return;
    }
    login(no, pin);
  });

  // セッション中は再ログイン不要
  try {
    const saved = sessionStorage.getItem('fl_member');
    if (saved) renderDash(JSON.parse(saved));
  } catch (e) {}
</script>

<style>
  .narrow { max-width: 640px; }
  .panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
  }
  .login-lead { color: var(--color-text-muted); line-height: 1.8; margin-bottom: 1.5rem; text-align: center; }
  .login-form { display: grid; gap: 1rem; }
  .field { display: grid; gap: 0.4rem; }
  .field-label { font-weight: 700; font-size: 0.9rem; }
  .field input {
    width: 100%; padding: 0.8rem 1rem;
    border: 2px solid var(--color-border); border-radius: 10px;
    font-size: 1.05rem; background: var(--color-bg); color: var(--color-text);
  }
  .field input:focus { outline: none; border-color: var(--color-primary); }
  .btn-block { width: 100%; }
  .btn-sm { padding: 0.4rem 0.9rem; font-size: 0.85rem; }
  .login-msg { text-align: center; font-size: 0.9rem; min-height: 1.2em; }
  .login-msg.error { color: #d33; }
  .login-note {
    margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px solid var(--color-border);
    color: var(--color-text-muted); font-size: 0.85rem; text-align: center; line-height: 1.7;
  }

  .dash-head {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;
    padding-bottom: 1.2rem; margin-bottom: 1.2rem; border-bottom: 2px solid var(--color-border);
  }
  .dash-hello { font-size: 1.15rem; }
  .dash-sub { color: var(--color-text-muted); font-size: 0.88rem; margin-top: 0.3rem; }
  .teller { display: inline-block; margin-left: 0.3rem; }

  .score-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.8rem; }
  .score-card {
    background: var(--color-bg-soft); border: 1px solid var(--color-border);
    border-radius: 14px; padding: 1.3rem 1rem; text-align: center;
  }
  .score-card.accent { border-color: var(--color-primary); }
  .score-label { color: var(--color-text-muted); font-size: 0.85rem; }
  .score-value { font-size: 2.4rem; font-weight: 800; color: var(--color-primary-soft); line-height: 1.1; margin-top: 0.3rem; }
  .score-unit { font-size: 1rem; font-weight: 600; margin-left: 0.15rem; }

  .block { margin-bottom: 1.5rem; }
  .block-h { font-size: 1.05rem; margin-bottom: 0.7rem; color: var(--color-primary-soft); }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    border-radius: 999px; padding: 0.35rem 0.9rem; font-size: 0.85rem;
    border: 1px solid var(--color-border); background: var(--color-bg-soft);
  }
  .chip-title { border-color: var(--color-accent); color: var(--color-accent-soft); }
  .chip-cert { color: var(--color-primary-soft); }
  .chip-empty { color: var(--color-text-muted); font-size: 0.88rem; }
  .course-list { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.35rem; color: var(--color-text-muted); font-size: 0.92rem; }

  /* 鑑定ロープレ評価（パラメータ） */
  .eval-block {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.3rem 1.3rem 1.4rem;
  }
  .eval-meta { color: var(--color-text-muted); font-size: 0.82rem; margin: -0.3rem 0 0.8rem; }
  .eval-wrap { display: grid; grid-template-columns: 300px 1fr; gap: 1.2rem; align-items: center; }
  .eval-radar { text-align: center; }
  .radar { width: 100%; max-width: 320px; height: auto; }
  .rad-grid { fill: none; stroke: var(--color-border); stroke-width: 1; }
  .rad-axis { stroke: var(--color-border); stroke-width: 1; }
  .rad-area { fill: rgba(46, 74, 138, 0.28); stroke: var(--color-primary); stroke-width: 2; }
  .rad-dot { fill: var(--color-primary); }
  .rad-label { fill: var(--color-text-muted); font-size: 11px; font-family: var(--font-sans); }
  .eval-avg { margin-top: 0.2rem; font-size: 0.95rem; color: var(--color-text-muted); }
  .eval-avg strong { font-size: 1.4rem; color: var(--color-primary-soft); }
  .eval-bars { display: grid; gap: 0.55rem; }
  .ev-row { display: grid; grid-template-columns: 6.5em 1fr 1.6em; align-items: center; gap: 0.6rem; font-size: 0.86rem; }
  .ev-name { color: var(--color-text); white-space: nowrap; }
  .ev-bar { height: 9px; border-radius: 999px; background: var(--color-border); overflow: hidden; }
  .ev-fill { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--color-primary-soft), var(--color-primary)); }
  .ev-num { text-align: right; font-weight: 700; color: var(--color-primary-soft); }
  .eval-comment { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .ev-c-label { font-weight: 700; font-size: 0.85rem; margin-bottom: 0.3rem; color: var(--color-primary-soft); }
  .eval-comment p:last-child { color: var(--color-text-muted); font-size: 0.92rem; line-height: 1.8; }

  @media (max-width: 560px) {
    .eval-wrap { grid-template-columns: 1fr; }
  }
</style>
