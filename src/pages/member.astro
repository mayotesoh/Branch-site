---
import Layout from '../layouts/Layout.astro';
import { GAS_URL, LINE_URL, SISTER_SITE_URL, SISTER_SITE_NAME } from '../consts';
import { getEvents, getThemes } from '../lib/notion';

// これから（今日以降）のイベントを予約・出席用に埋め込む
const _t = new Date();
_t.setHours(0, 0, 0, 0);
const memberEvents = (await getEvents())
  .filter((e) => e.date && new Date(e.date).getTime() >= _t.getTime())
  .map((e) => ({
    id: e.pageId,
    name: e.name,
    type: e.type,
    date: e.date,
    end: e.end,
    accepting: e.accepting,
  }));

// 今週の題材（会員ページから読み解きを投稿できるように）
const _themes = await getThemes();
const _cur = _themes.find((t) => t.current) ?? _themes[0] ?? null;
const memberTheme = _cur ? { id: _cur.pageId, title: _cur.title, desc: _cur.desc } : null;
---

<Layout
  title="会員ページ｜Fortune Labo"
  description="Fortune Labo 会員専用ページ。会員番号と暗証番号でログインし、あなたのスコア・評定・受講状況を確認できます。"
>
  <section class="section">
    <div class="container narrow">
      <h1 class="section-title">会員ページ</h1>

      <!-- ログイン -->
      <div id="login" class="panel">
        <p class="login-lead">
          会員番号と暗証番号（4桁）でログインしてください。<br />
          暗証番号は運営からご案内した番号です。
        </p>
        <form id="login-form" class="login-form" novalidate>
          <label class="field">
            <span class="field-label">会員番号</span>
            <input id="memberNo" type="text" inputmode="text" autocomplete="off"
              placeholder="例：BR-001" required />
          </label>
          <label class="field">
            <span class="field-label">暗証番号（4桁）</span>
            <input id="pin" type="password" inputmode="numeric" autocomplete="off"
              maxlength="4" pattern="[0-9]*" placeholder="••••" required />
          </label>
          <button id="login-btn" type="submit" class="btn btn-primary btn-block">ログイン</button>
          <p id="login-msg" class="login-msg" role="alert" aria-live="polite"></p>
        </form>
        <details class="login-help">
          <summary>会員番号・パスワードがわからない方はこちら</summary>
          <div class="login-help-body">
            <p>公式LINEのトークから、その場で確認・変更できます。</p>
            <ol class="login-help-steps">
              <li>下のボタンから<strong>公式LINEを友だち追加</strong></li>
              <li>トークで <strong>「ID確認」</strong> と送信</li>
              <li>案内にそって <strong>お名前（フルネーム）</strong> を送信<br />
                <span class="login-help-note">「山田太郎」でも「山田 太郎」でもOK</span></li>
              <li>あなたの<strong>会員番号とパスワード</strong>が届きます</li>
              <li>そのまま <strong>「ID変更」「パスワード変更」</strong> で好きな値に変更も可能</li>
            </ol>
            <a class="btn btn-line login-help-line" href={LINE_URL} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3C6.48 3 2 6.6 2 11.02c0 2.55 1.5 4.8 3.86 6.25-.17.6-.62 2.2-.71 2.54-.11.42.16.41.33.3.14-.09 2.16-1.43 3.04-2.02.78.11 1.59.17 2.48.17 5.52 0 10-3.6 10-8.04C22 6.6 17.52 3 12 3z"></path>
              </svg>
              公式LINEを開く
            </a>
            <p class="login-help-note">うまくいかない場合は、そのままLINEで運営にお問い合わせください。</p>
          </div>
        </details>
      </div>

      <!-- ダッシュボード -->
      <div id="dash" hidden></div>
    </div>
  </section>
</Layout>

<script define:vars={{ GAS_URL, memberEvents, memberTheme, SISTER_SITE_URL, SISTER_SITE_NAME }} is:inline>
  const loginBox = document.getElementById('login');
  const dash = document.getElementById('dash');
  const form = document.getElementById('login-form');
  const msg = document.getElementById('login-msg');
  const btn = document.getElementById('login-btn');
  const noEl = document.getElementById('memberNo');
  const pinEl = document.getElementById('pin');

  const esc = (s) =>
    String(s == null ? '' : s).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])
    );
  const chips = (arr, cls) =>
    (arr && arr.length)
      ? arr.map((x) => `<span class="chip ${cls}">${esc(x)}</span>`).join('')
      : '<span class="chip-empty">まだありません</span>';

  // ── 鑑定ロープレ評価（パラメータ表示） ──
  const EVAL_ITEMS = ['声・話し方', '聞く姿勢', '言葉選び', '鑑定の流れ', '鑑定内容', '安心感'];

  function radarSVG(scores) {
    const cx = 160, cy = 152, R = 92, N = 6, MAX = 5;
    const ang = (i) => (-90 + i * (360 / N)) * Math.PI / 180;
    const pt = (i, r) => [cx + r * Math.cos(ang(i)), cy + r * Math.sin(ang(i))];
    let grid = '';
    for (let g = 1; g <= MAX; g++) {
      const r = (R * g) / MAX;
      const pts = EVAL_ITEMS.map((_, i) => pt(i, r).map((v) => v.toFixed(1)).join(',')).join(' ');
      grid += `<polygon points="${pts}" class="rad-grid"/>`;
    }
    let axes = '';
    EVAL_ITEMS.forEach((_, i) => { const [x, y] = pt(i, R); axes += `<line x1="${cx}" y1="${cy}" x2="${x.toFixed(1)}" y2="${y.toFixed(1)}" class="rad-axis"/>`; });
    const dpts = EVAL_ITEMS.map((k, i) => { const v = Math.max(0, Math.min(MAX, scores[k] || 0)); return pt(i, (R * v) / MAX).map((n) => n.toFixed(1)).join(','); }).join(' ');
    let dots = '', labels = '';
    EVAL_ITEMS.forEach((k, i) => {
      const v = Math.max(0, Math.min(MAX, scores[k] || 0));
      const [dx, dy] = pt(i, (R * v) / MAX);
      dots += `<circle cx="${dx.toFixed(1)}" cy="${dy.toFixed(1)}" r="3.2" class="rad-dot"/>`;
      const [lx, ly] = pt(i, R + 15);
      let anchor = 'middle'; if (lx > cx + 5) anchor = 'start'; else if (lx < cx - 5) anchor = 'end';
      labels += `<text x="${lx.toFixed(1)}" y="${(ly + 4).toFixed(1)}" text-anchor="${anchor}" class="rad-label">${esc(k)}</text>`;
    });
    return `<svg viewBox="0 0 320 300" class="radar" role="img" aria-label="鑑定ロープレ評価レーダー">${grid}${axes}<polygon points="${dpts}" class="rad-area"/>${dots}${labels}</svg>`;
  }

  function evalBars(scores) {
    return EVAL_ITEMS.map((k) => {
      const v = scores[k];
      const pct = v != null ? (v / 5) * 100 : 0;
      return `<div class="ev-row"><span class="ev-name">${esc(k)}</span><span class="ev-bar"><span class="ev-fill" style="width:${pct}%"></span></span><span class="ev-num">${v != null ? esc(v) : '—'}</span></div>`;
    }).join('');
  }

  function evalSection(ev) {
    if (!ev || !ev.scores) return '';
    const vals = EVAL_ITEMS.map((k) => ev.scores[k]).filter((v) => v != null);
    if (!vals.length) return '';
    const avg = vals.reduce((a, b) => a + b, 0) / vals.length;
    const meta = [ev.date ? `評価日：${esc(ev.date)}` : '', ev.evaluator ? `評価者：${esc(ev.evaluator)}` : ''].filter(Boolean).join(' ／ ');
    const comment = ev.comment
      ? `<div class="eval-comment"><p class="ev-c-label">総合コメント</p><p>${esc(ev.comment)}</p></div>` : '';
    return `
      <div class="block eval-block">
        <h2 class="block-h">鑑定ロープレ評価</h2>
        ${meta ? `<p class="eval-meta">${meta}</p>` : ''}
        <div class="eval-wrap">
          <div class="eval-radar">${radarSVG(ev.scores)}<p class="eval-avg">平均 <strong>${avg.toFixed(1)}</strong> / 5</p></div>
          <div class="eval-bars">${evalBars(ev.scores)}</div>
        </div>
        ${comment}
      </div>`;
  }

  // ── 参加スタンプ（定例会・セミナー等の参加履歴） ──
  const STAMP_ICON = {
    '定例会': '🗓️', 'スキルアップ講座': '📚', 'リーディング会': '🔮',
    'ロープレ': '🃏', 'マルシェ・イベント': '🎪', 'zoom解放日': '💻', 'ライブトーク': '🎙️',
  };
  // 出席回数に応じた称号
  function rankFromStamps(n) {
    if (n >= 30) return '👑 レジェンド';
    if (n >= 20) return '🌟 マスター';
    if (n >= 10) return '🔥 皆勤の達人';
    if (n >= 5) return '✨ 常連メンバー';
    if (n >= 1) return '🌱 はじめの一歩';
    return '';
  }
  function stampBlock(stamps) {
    const list = Array.isArray(stamps) ? stamps : [];
    const attended = list.filter((s) => s.status === '出席');
    const inner = list.length
      ? `<div class="stamp-grid">${list.map((s) => {
          const ic = STAMP_ICON[s.type] || '✦';
          const cls = s.status === '出席' ? 'is-on' : (s.status === '申込' ? 'is-up' : '');
          const meta = [s.date, s.status].filter(Boolean).map(esc).join(' ・ ');
          return `<div class="stamp ${cls}"><span class="stamp-ic">${ic}</span>`
            + `<span class="stamp-name">${esc(s.event || s.type || 'イベント')}</span>`
            + `<span class="stamp-meta">${meta}</span></div>`;
        }).join('')}</div>`
      : '<p class="chip-empty">まだ参加記録がありません。定例会やセミナーに参加するとスタンプがたまります。</p>';
    const rank = rankFromStamps(attended.length);
    const rankHtml = rank ? `<span class="stamp-rank">${esc(rank)}</span>` : '';
    return `<div class="block">`
      + `<h2 class="block-h">参加スタンプ <span class="stamp-count">出席 ${attended.length} 回</span>${rankHtml}</h2>`
      + `${inner}</div>`;
  }

  // 今週の題材への読み解き投稿
  function themeBlock() {
    if (!memberTheme) return '';
    return `<details class="block theme-block">`
      + `<summary class="mev-summary"><span class="mev-summary-t">📝 今週の題材に読み解きを投稿</span>`
      + `<span class="mev-toggle"><span class="mev-toggle-txt"></span><span class="mev-caret">▾</span></span></summary>`
      + `<p class="theme-q"><strong>お題：</strong>${esc(memberTheme.title)}</p>`
      + (memberTheme.desc ? `<p class="theme-qd">${esc(memberTheme.desc)}</p>` : '')
      + `<label class="theme-lbl">あなたの読み解き</label>`
      + `<textarea class="theme-input" id="themeContent" rows="5" placeholder="この方をどう読み解きますか？（占術・見立て・アドバイスなど）"></textarea>`
      + `<label class="theme-lbl">表示名（ペンネーム）</label>`
      + `<input class="theme-pen" id="themePen" type="text" placeholder="例：さくら" />`
      + `<label class="theme-pub"><input type="checkbox" id="themePublic" checked /> <span>この読み解きをサイトに公開してよい</span></label>`
      + `<button class="btn btn-primary btn-sm theme-submit" id="themeSubmit">投稿する</button>`
      + `<p class="theme-msg" id="themeMsg" aria-live="polite"></p></details>`;
  }

  // ── イベント予約・出席確認 ──
  let creds = null; // {no, pin} 予約/出席確認に使う
  const WD = ['日', '月', '火', '水', '木', '金', '土'];
  function evFmt(iso) {
    const d = new Date(iso);
    if (isNaN(d)) return '';
    const t = iso.includes('T')
      ? ` ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`
      : '';
    return `${d.getMonth() + 1}月${d.getDate()}日（${WD[d.getDay()]}）${t}`;
  }
  function eventsBlock(stamps) {
    if (!Array.isArray(memberEvents) || !memberEvents.length) return '';
    const stateByEvent = {};
    (stamps || []).forEach((s) => { if (s.eventId) stateByEvent[s.eventId] = s.status; });
    const rows = memberEvents.map((e) => {
      const st = stateByEvent[e.id];
      const ic = STAMP_ICON[e.type] || '✦';
      const tags = `<span class="mev-type">${ic} ${esc(e.type || 'イベント')}</span>`
        + (e.accepting ? '<span class="mev-open">受付中</span>' : '');
      let actions;
      if (st === '出席') {
        actions = '<span class="mev-done">✓ 出席済み</span>';
      } else {
        const reserve = st === '申込'
          ? `<span class="mev-reserved">✓ 予約済み</span>`
            + `<button class="btn btn-ghost btn-sm mev-cancel" data-id="${esc(e.id)}">予約を取り消す</button>`
          : `<button class="btn btn-primary btn-sm mev-reserve" data-id="${esc(e.id)}">予約する</button>`;
        actions = `${reserve}`
          + `<div class="mev-checkin">`
          + `<input class="mev-code" type="text" data-id="${esc(e.id)}" placeholder="当日の合言葉" autocomplete="off" />`
          + `<button class="btn btn-ghost btn-sm mev-attend" data-id="${esc(e.id)}">出席</button>`
          + `</div>`;
      }
      return `<div class="mev"><div class="mev-head">${tags}</div>`
        + `<p class="mev-name">${esc(e.name)}</p>`
        + `<p class="mev-date">${esc(evFmt(e.date))}</p>`
        + `<div class="mev-actions">${actions}</div>`
        + `<p class="mev-msg" data-id="${esc(e.id)}" aria-live="polite"></p></div>`;
    }).join('');
    return `<details class="block mev-block" open>`
      + `<summary class="mev-summary">`
      + `<span class="mev-summary-t">📅 イベント予約・出席</span>`
      + `<span class="mev-toggle"><span class="mev-toggle-txt"></span><span class="mev-caret">▾</span></span>`
      + `</summary>`
      + `<p class="mev-lead">参加したいイベントを予約できます。当日は運営が発表する合言葉を入力すると出席になります。</p>`
      + `<div class="mev-list">${rows}</div></details>`;
  }

  function renderDash(d) {
    loginBox.hidden = true;
    dash.hidden = false;
    const teller = d.tellerName ? `<span class="teller">占い師名：${esc(d.tellerName)}</span>` : '';
    const courses = (d.courses && d.courses.length)
      ? `<ul class="course-list">${d.courses.map((c) => `<li>${esc(c)}</li>`).join('')}</ul>`
      : '<p class="chip-empty">受講講座はまだ記録されていません。</p>';
    dash.innerHTML = `
      <div class="dash-head">
        <div>
          <p class="dash-hello">ようこそ、<strong>${esc(d.name || '会員')}</strong> さん</p>
          <p class="dash-sub">${esc(d.memberNo || '')} ${d.memberStatus ? '／ ' + esc(d.memberStatus) : ''} ${teller}</p>
          ${(d.coupon != null && d.coupon > 0) ? `<p class="dash-coupon">🎫 クーポン残高：<strong>${esc(d.coupon)}円</strong></p>` : ''}
        </div>
        <button id="logout" class="btn btn-ghost btn-sm">ログアウト</button>
      </div>

      ${eventsBlock(d.stamps)}

      ${themeBlock()}

      <div class="block">
        <h2 class="block-h">対応占術</h2>
        <div class="chip-row">${chips(d.arts, 'chip-art')}</div>
      </div>

      ${stampBlock(d.stamps)}

      ${evalSection(d.evaluation)}

      <div class="block">
        <h2 class="block-h">認定・テスト</h2>
        <div class="chip-row">${chips(d.certs, 'chip-cert')}</div>
      </div>
      <div class="block">
        <h2 class="block-h">受講した講座</h2>
        ${courses}
      </div>

      <div class="block grace-note">
        <p>個別鑑定で収益化したい方は、鑑定サイト「${esc(SISTER_SITE_NAME)}」に登録して活動できます。</p>
        <a class="btn btn-ghost btn-sm" href="${SISTER_SITE_URL}" target="_blank" rel="noopener noreferrer">${esc(SISTER_SITE_NAME)}を見る ↗</a>
      </div>
    `;
    document.getElementById('logout').addEventListener('click', () => {
      creds = null;
      try { sessionStorage.removeItem('fl_member_v2'); sessionStorage.removeItem('fl_cred'); } catch (e) {}
      dash.hidden = true;
      loginBox.hidden = false;
      form.reset();
      msg.textContent = '';
    });
    dash.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // GAS 共通POST
  async function postGas(payload) {
    const res = await fetch(GAS_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload),
    });
    return res.json();
  }
  // 予約/出席の後にダッシュボードを最新化
  async function refreshDash() {
    if (!creds) return;
    try {
      const data = await postGas({ action: 'member_login', memberNo: creds.no, pin: creds.pin });
      if (data.status === 'ok') {
        try { sessionStorage.setItem('fl_member_v2', JSON.stringify(data)); } catch (e) {}
        renderDash(data);
      }
    } catch (e) {}
  }

  // 今週の題材への読み解き投稿
  dash.addEventListener('click', async (e) => {
    const btn = e.target.closest('.theme-submit');
    if (!btn) return;
    const contentEl = document.getElementById('themeContent');
    const penEl = document.getElementById('themePen');
    const pubEl = document.getElementById('themePublic');
    const msgEl = document.getElementById('themeMsg');
    const setMsg = (t, ok) => { if (msgEl) { msgEl.textContent = t; msgEl.className = 'theme-msg ' + (ok ? 'ok' : 'error'); } };
    const content = contentEl ? contentEl.value.trim() : '';
    if (!content) { setMsg('読み解きを入力してください。', false); return; }
    if (!creds) { setMsg('再ログインしてください。', false); return; }
    if (!memberTheme) { setMsg('現在のお題がありません。', false); return; }
    btn.disabled = true; btn.textContent = '投稿中…';
    try {
      const r = await postGas({
        action: 'submit_reading', memberNo: creds.no, pin: creds.pin,
        themeId: memberTheme.id, content,
        penName: penEl ? penEl.value.trim() : '',
        publicOk: pubEl ? pubEl.checked : true,
      });
      if (r.status === 'ok') {
        setMsg('投稿しました！公開にした読み解きは、サイト更新後にお題ページへ表示されます。', true);
        if (contentEl) contentEl.value = '';
      } else { setMsg(r.message || '投稿できませんでした。', false); btn.disabled = false; btn.textContent = '投稿する'; }
    } catch (err) { setMsg('通信に失敗しました。', false); btn.disabled = false; btn.textContent = '投稿する'; }
  });

  // 予約・出席ボタン（ダッシュボードは再描画されるためデリゲートで一度だけ登録）
  dash.addEventListener('click', async (e) => {
    const rBtn = e.target.closest('.mev-reserve');
    const aBtn = e.target.closest('.mev-attend');
    const cBtn = e.target.closest('.mev-cancel');
    if (!rBtn && !aBtn && !cBtn) return;
    const id = (rBtn || aBtn || cBtn).dataset.id;
    const msgEl = dash.querySelector(`.mev-msg[data-id="${id}"]`);
    const setMsg = (t, ok) => { if (msgEl) { msgEl.textContent = t; msgEl.className = 'mev-msg ' + (ok ? 'ok' : 'error'); } };
    if (!creds) { setMsg('再ログインしてください。', false); return; }

    if (cBtn) {
      if (!confirm('この予約を取り消しますか？')) return;
      cBtn.disabled = true; cBtn.textContent = '取消中…';
      try {
        const r = await postGas({ action: 'event_cancel', memberNo: creds.no, pin: creds.pin, eventId: id });
        if (r.status === 'ok') { setMsg('予約を取り消しました。', true); await refreshDash(); }
        else { setMsg(r.message || 'キャンセルできませんでした。', false); cBtn.disabled = false; cBtn.textContent = '予約を取り消す'; }
      } catch (err) { setMsg('通信に失敗しました。', false); cBtn.disabled = false; cBtn.textContent = '予約を取り消す'; }
      return;
    }

    if (rBtn) {
      rBtn.disabled = true; rBtn.textContent = '送信中…';
      try {
        const r = await postGas({ action: 'event_reserve', memberNo: creds.no, pin: creds.pin, eventId: id });
        if (r.status === 'ok') { setMsg(r.already ? 'すでに予約済みです。' : '予約しました！', true); await refreshDash(); }
        else { setMsg(r.message || '予約できませんでした。', false); rBtn.disabled = false; rBtn.textContent = '予約する'; }
      } catch (err) { setMsg('通信に失敗しました。', false); rBtn.disabled = false; rBtn.textContent = '予約する'; }
      return;
    }

    // 出席（合言葉）
    const codeEl = dash.querySelector(`.mev-code[data-id="${id}"]`);
    const code = codeEl ? codeEl.value.trim() : '';
    if (!code) { setMsg('当日の合言葉を入力してください。', false); return; }
    aBtn.disabled = true; aBtn.textContent = '確認中…';
    try {
      const r = await postGas({ action: 'event_checkin', memberNo: creds.no, pin: creds.pin, eventId: id, code });
      if (r.status === 'ok') { setMsg('出席を確認しました！', true); await refreshDash(); }
      else { setMsg(r.message || '出席確認できませんでした。', false); aBtn.disabled = false; aBtn.textContent = '出席'; }
    } catch (err) { setMsg('通信に失敗しました。', false); aBtn.disabled = false; aBtn.textContent = '出席'; }
  });

  async function login(memberNo, pin) {
    btn.disabled = true;
    btn.textContent = 'ログイン中…';
    msg.textContent = '';
    msg.className = 'login-msg';
    try {
      const res = await fetch(GAS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ action: 'member_login', memberNo, pin }),
      });
      const data = await res.json();
      if (data.status === 'ok') {
        creds = { no: memberNo, pin };
        try {
          sessionStorage.setItem('fl_member_v2', JSON.stringify(data));
          sessionStorage.setItem('fl_cred', JSON.stringify(creds));
        } catch (e) {}
        renderDash(data);
      } else {
        msg.textContent = data.message || 'ログインできませんでした。';
        msg.className = 'login-msg error';
      }
    } catch (e) {
      msg.textContent = '通信に失敗しました。時間をおいて再度お試しください。';
      msg.className = 'login-msg error';
    } finally {
      btn.disabled = false;
      btn.textContent = 'ログイン';
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const no = noEl.value.trim();
    const pin = pinEl.value.trim();
    if (!no || !pin) {
      msg.textContent = '会員番号と暗証番号を入力してください。';
      msg.className = 'login-msg error';
      return;
    }
    login(no, pin);
  });

  // セッション中は再ログイン不要
  try {
    const savedCred = sessionStorage.getItem('fl_cred');
    if (savedCred) creds = JSON.parse(savedCred);
    const saved = sessionStorage.getItem('fl_member_v2');
    if (saved) renderDash(JSON.parse(saved));
  } catch (e) {}
</script>

