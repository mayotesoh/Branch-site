---
import Layout from '../layouts/Layout.astro';
import LineButton from '../components/LineButton.astro';
import { INSTAGRAM_URL } from '../consts';
import { getInstaPosts, getPosts, getEvents } from '../lib/notion';

const base = import.meta.env.BASE_URL;
const joinUrl = `${base.replace(/\/$/, '')}/join`;
const blogUrl = `${base.replace(/\/$/, '')}/blog`;
const eventsUrl = `${base.replace(/\/$/, '')}/events`;
const postUrl = (slug: string) => `${base.replace(/\/$/, '')}/blog/${slug}`;
const fmtDate = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;

const EV_TYPE_ICON: Record<string, string> = {
  定例会: '🗓️',
  スキルアップ講座: '📚',
  リーディング会: '🔮',
  ロープレ: '🃏',
  'マルシェ・イベント': '🎪',
  zoom解放日: '💻',
};
const EV_WD = ['日', '月', '火', '水', '木', '金', '土'];
const fmtEvent = (iso: string) => {
  const d = new Date(iso);
  const time = iso.includes('T')
    ? `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`
    : '';
  return { md: `${d.getMonth() + 1}/${d.getDate()}`, wd: EV_WD[d.getDay()], time };
};

const instaPosts = await getInstaPosts();
const latestPosts = (await getPosts()).slice(0, 3);

// 今後のイベント（開催日が今日以降）を近い順に最大3件
const _today = new Date();
_today.setHours(0, 0, 0, 0);
const upcomingEvents = (await getEvents())
  .filter((e) => e.date && new Date(e.date).getTime() >= _today.getTime())
  .slice(0, 3);

const features = [
  {
    icon: '🔮',
    img: 'feat-tarot.webp?v=3',
    title: '占術の基礎を学ぶ',
    desc: 'タロット・西洋占星術・東洋占術など、各占術の基礎から体系的に学べる学習コンテンツを用意します。',
  },
  {
    icon: '🗣️',
    img: 'feat-reading.webp?v=3',
    title: 'リーディング実践',
    desc: '実際の鑑定を想定したロールプレイや相互練習で、伝える力・聴く力を磨きます。',
  },
  {
    icon: '🌱',
    img: 'feat-activity.webp?v=3',
    title: '活動の広げ方',
    desc: '集客・料金設定・SNS発信・対面/オンライン鑑定など、占い師として活動するノウハウを共有します。',
  },
  {
    icon: '🤝',
    img: 'feat-community.webp?v=3',
    title: '仲間とのつながり',
    desc: '同じ志を持つ仲間と悩みを相談し合い、互いに高め合えるコミュニティです。',
  },
];

const steps = [
  { no: '01', title: '学ぶ', desc: '基礎講座とアーカイブで自分のペースでインプット。' },
  { no: '02', title: '練習する', desc: '仲間と鑑定を練習し、フィードバックをもらう。' },
  { no: '03', title: '活動する', desc: '学びを実践に変え、占い師として一歩を踏み出す。' },
];
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <h1 class="hero-wordmark">
        <img
          src={`${base.replace(/\/$/, '')}/wordmark2.webp`}
          width="1748"
          height="204"
          alt="Fortune Labo ─ 占い師のための教育コミュニティ"
          fetchpriority="high"
        />
      </h1>
      <p class="hero-title">
        稼げる占い師を、<wbr />育成する場所。
      </p>
      <p class="hero-lead">
        Fortune Labo（フォーチュンラボ）は、占いを「仕事」にして稼げる占い師を育てる教育コミュニティです。<br />
        基礎から実践、そして集客・活動の広げ方まで、仲間とともに一歩ずつ。
      </p>
      <div class="hero-actions">
        <LineButton label="LINEで予約・参加する" />
        <a class="btn btn-ghost" href="#about">Fortune Laboについて知る</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container">
      <h2 class="section-title">Fortune Labo とは</h2>
      <p class="section-lead">一人ひとりの可能性を伸ばす、占い師のための学びのコミュニティ</p>
      <div class="about-grid">
        <p>
          占いを学びたい、もっと上手くなりたい、いつか占い師として活動したい。
          そんな想いを持つ人が集まり、安心して学び合える場所をつくりました。
        </p>
        <p>
          一人で続けるのは難しくても、仲間がいれば前に進めます。
          Fortune Laboは知識のインプットだけでなく、実践・相談・つながりまでを大切にする教育コミュニティです。
        </p>
      </div>
      <div class="about-more">
        <span class="btn btn-disabled" aria-disabled="true">
          コミュニティ紹介（提案資料）｜準備中
        </span>
        <p class="about-more-note">ただいま新しい資料を準備中です。公開までもうしばらくお待ちください。</p>
      </div>
    </div>
  </section>

  <!-- 今後のイベント -->
  {
    upcomingEvents.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section-title">今後のイベント</h2>
          <p class="section-lead">定例会・講座・リーディング会など、次の学びの場</p>
          <ul class="home-ev-list">
            {upcomingEvents.map((e) => {
              const d = fmtEvent(e.date);
              return (
                <li class="home-ev">
                  <div class="home-ev-date">
                    <span class="home-ev-md">{d.md}</span>
                    <span class="home-ev-wd">（{d.wd}）{d.time}</span>
                  </div>
                  <div class="home-ev-body">
                    <div class="home-ev-tags">
                      {e.type && (
                        <span class="home-ev-type">
                          {EV_TYPE_ICON[e.type] ?? '✦'} {e.type}
                        </span>
                      )}
                      {e.accepting && <span class="home-ev-open">受付中</span>}
                    </div>
                    <p class="home-ev-name">{e.name}</p>
                  </div>
                  {e.url && (
                    <a
                      class="home-ev-cta"
                      href={e.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${e.name}の詳細`}
                    >
                      詳細 →
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
          <div class="home-ev-more">
            <a class="btn btn-primary" href={eventsUrl}>イベント一覧を見る →</a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Features -->
  <section id="features" class="section section-alt">
    <div class="container">
      <h2 class="section-title">学べること</h2>
      <p class="section-lead">基礎から実践、活動まで。占い師に必要な学びがそろう。</p>
      <div class="feature-grid">
        {
          features.map((f) => (
            <article class="card">
              <div class="card-media">
                {f.img ? (
                  <img
                    class="card-photo"
                    src={`${base.replace(/\/$/, '')}/${f.img}`}
                    width="640"
                    height="360"
                    alt=""
                    loading="lazy"
                  />
                ) : (
                  <span class="card-emoji">{f.icon}</span>
                )}
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section id="community" class="section">
    <div class="container">
      <h2 class="section-title">学びの流れ</h2>
      <p class="section-lead">あなたのペースで、3つのステップ</p>
      <div class="step-grid">
        {
          steps.map((s) => (
            <article class="step">
              <span class="step-no">{s.no}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Latest Blog -->
  {
    latestPosts.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <h2 class="section-title">最新のブログ</h2>
          <p class="section-lead">Fortune Laboの占い師が綴る、学びと気づき</p>
          <ul class="blog-grid">
            {latestPosts.map((post) => (
              <li class="blog-card">
                <a class="blog-card-link" href={postUrl(post.slug)}>
                  {post.cover && (
                    <div class="blog-cover">
                      <img src={post.cover} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="blog-body">
                    <div class="blog-meta">
                      <span>{fmtDate(post.publishDate)}</span>
                      {post.authorName && <span class="blog-author">{post.authorName}</span>}
                    </div>
                    <h3 class="blog-title">{post.title}</h3>
                    {post.excerpt && <p class="blog-excerpt">{post.excerpt}</p>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <div class="blog-more">
            <a class="btn btn-primary" href={blogUrl}>ブログをもっと見る →</a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Instagram -->
  {
    (instaPosts.length > 0 || INSTAGRAM_URL) && (
      <section class="section section-alt insta-section">
        <div class="container">
          <h2 class="section-title">Instagram</h2>
          <p class="section-lead">Fortune Laboの日々の活動や学びの様子を発信しています</p>

          {instaPosts.length > 0 && (
            <div class="insta-grid">
              {instaPosts.map((post) => (
                <div class="insta-embed">
                  <iframe
                    src={`https://www.instagram.com/p/${post.shortcode}/embed/`}
                    title={post.title || 'Instagram投稿'}
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          )}

          {INSTAGRAM_URL && (
            <div class="insta-follow">
              <a class="btn btn-primary" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
                Instagramでフォローする
              </a>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">
      <h2>あなたの占いを、次のステージへ。</h2>
      <p>Fortune Laboで仲間と学び、占い師としての一歩を踏み出しましょう。</p>
      <div class="cta-actions">
        <LineButton label="LINEで予約・参加する" />
        <a class="btn btn-ghost" href={joinUrl}>参加方法を見る</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ロゴの夜空に合わせたネイビーのヒーロー */
  .hero {
    min-height: 84vh;
    display: flex;
    align-items: center;
    padding-block: 4rem;
    text-align: center;
    color: #fff;
    position: relative;
    overflow: hidden;
    /* 夜空を全面カバー背景に（縦を大きくして横の見切れ側に寄せる）＋文字を上に載せる */
    background:
      linear-gradient(180deg, rgba(9, 16, 38, 0.30) 0%, rgba(9, 16, 38, 0.26) 45%, rgba(9, 16, 38, 0.60) 100%),
      url('/hero3.webp') center / cover no-repeat;
    background-color: #0e1836;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  /* ロゴ（白文字・透過）を中央に */
  .hero-wordmark {
    margin: 0 auto 1.6rem;
    max-width: min(560px, 86vw);
    line-height: 0;
  }
  .hero-wordmark img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.6));
  }
  .hero-title {
    font-size: clamp(1.5rem, 4.6vw, 2.3rem);
    margin-bottom: 1.3rem;
    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
    /* 日本語見出しを文字単位で割らず、<wbr> の位置でだけ折り返す */
    word-break: keep-all;
    line-break: strict;
    overflow-wrap: normal;
  }
  .hero-lead {
    color: rgba(255, 255, 255, 0.85);
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: 2.4rem;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  /* 暗いヒーロー上ではゴーストボタンを明色に */
  .hero .btn-ghost {
    border-color: rgba(255, 255, 255, 0.45);
    color: #fff;
  }
  .hero .btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(255, 255, 255, 0.04);
  }

  .section-alt {
    background: var(--color-bg-soft);
    border-block: 1px solid var(--color-border);
  }

  /* Instagram */
  .insta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.2rem;
    max-width: 920px;
    margin-inline: auto;
  }
  .insta-embed {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }
  .insta-embed iframe {
    width: 100%;
    height: 480px;
    display: block;
    border: 0;
  }
  .insta-follow {
    text-align: center;
    margin-top: 2rem;
  }

  /* 今後のイベント */
  .home-ev-list {
    list-style: none;
    display: grid;
    gap: 0.9rem;
    max-width: 780px;
    margin-inline: auto;
  }
  .home-ev {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius);
    padding: 1rem 1.3rem;
  }
  .home-ev-date {
    flex-shrink: 0;
    width: 92px;
    text-align: center;
    border-right: 1px solid var(--color-border);
    padding-right: 1rem;
  }
  .home-ev-md {
    display: block;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-primary-soft);
    line-height: 1.1;
  }
  .home-ev-wd {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .home-ev-body {
    flex: 1;
    min-width: 0;
  }
  .home-ev-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.3rem;
  }
  .home-ev-type {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }
  .home-ev-open {
    background: #06c755;
    color: #fff;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.74rem;
    font-weight: 700;
  }
  .home-ev-name {
    font-weight: 700;
    line-height: 1.5;
  }
  .home-ev-cta {
    flex-shrink: 0;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--color-primary-soft);
    white-space: nowrap;
  }
  .home-ev-cta:hover {
    color: var(--color-primary);
  }
  .home-ev-more {
    text-align: center;
    margin-top: 2rem;
  }
  @media (max-width: 560px) {
    .home-ev {
      flex-wrap: wrap;
      gap: 0.7rem 1rem;
    }
    .home-ev-date {
      width: auto;
      text-align: left;
      border-right: none;
      padding-right: 0;
      display: flex;
      align-items: baseline;
      gap: 0.4rem;
    }
    .home-ev-cta {
      margin-left: auto;
    }
  }

  /* 最新のブログ */
  .blog-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    max-width: 980px;
    margin-inline: auto;
  }
  .blog-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 12px 28px rgba(26, 36, 64, 0.14);
  }
  .blog-card-link {
    display: block;
    color: inherit;
    height: 100%;
  }
  .blog-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .blog-body {
    padding: 1.2rem 1.4rem 1.5rem;
  }
  .blog-meta {
    display: flex;
    gap: 0.8rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .blog-author::before {
    content: '✦ ';
    color: var(--color-accent);
  }
  .blog-title {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }
  .blog-excerpt {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-more {
    text-align: center;
    margin-top: 2.2rem;
  }

  .about-grid {
    display: grid;
    gap: 1.5rem;
    max-width: 760px;
    margin-inline: auto;
    color: var(--color-text-muted);
  }
  .about-more {
    text-align: center;
    margin-top: 2rem;
  }
  .btn-disabled {
    display: inline-block;
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: 999px;
    padding: 0.85rem 2rem;
    font-weight: 700;
    cursor: not-allowed;
    pointer-events: none;
  }
  .about-more-note {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-top: 0.9rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.8rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }
  /* 丸フレームのアイコン/写真 */
  .card-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    box-shadow: 0 6px 18px rgba(26, 36, 64, 0.12);
  }
  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-emoji {
    font-size: 2.2rem;
    line-height: 1;
  }
  .card h3 {
    margin-bottom: 0.6rem;
    font-size: 1.15rem;
  }
  .card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .step-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .step {
    text-align: center;
    padding: 1.5rem;
  }
  .step-no {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }
  .step h3 {
    margin-bottom: 0.5rem;
  }
  .step p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .cta {
    padding-block: 5rem;
    text-align: center;
  }
  .cta-inner h2 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: 1rem;
  }
  .cta-inner p {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
