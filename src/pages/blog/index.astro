---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/notion';

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;

const fmtDate = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;

const posts = await getPosts();

// タグを出現数の多い順に集計（絞り込みバー用）
const tagCounts = new Map<string, number>();
posts.forEach((p) => p.tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const allTags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja')
);
---

<Layout
  title="ブログ｜Fortune Labo"
  description="Fortune Labo所属の占い師が綴る、占いの学びと日々の気づき。"
>
  <section class="section">
    <div class="container">
      <h1 class="section-title">ブログ</h1>
      <p class="section-lead">Fortune Laboの占い師が綴る、学びと気づき</p>

      {allTags.length > 0 && (
        <div class="tag-filter" id="tagFilter" role="group" aria-label="タグで絞り込み">
          <button class="tag-btn is-active" type="button" data-tag="">
            すべて<span class="tag-c">{posts.length}</span>
          </button>
          {allTags.map(([tag, count]) => (
            <button class="tag-btn" type="button" data-tag={tag}>
              #{tag}<span class="tag-c">{count}</span>
            </button>
          ))}
        </div>
      )}

      {
        posts.length === 0 ? (
          <p class="empty">まだ記事がありません。</p>
        ) : (
          <ul class="post-list" id="postList">
            {posts.map((post) => (
              <li class="post-card" data-tags={post.tags.join(',')}>
                <a class="post-link" href={link(`/blog/${post.slug}`)}>
                  {post.cover && (
                    <div class="post-cover">
                      <img src={post.cover} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="post-body">
                    <div class="post-meta">
                      <span class="post-date">{fmtDate(post.publishDate)}</span>
                      {post.authorName && (
                        <span class="post-author">{post.authorName}</span>
                      )}
                    </div>
                    <h2 class="post-title">{post.title}</h2>
                    {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
                    {post.tags.length > 0 && (
                      <ul class="post-tags">
                        {post.tags.map((t) => (
                          <li>#{t}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <p class="empty" id="noMatch" hidden>このタグの記事はまだありません。</p>
    </div>
  </section>

  <script>
    const filter = document.getElementById('tagFilter');
    const list = document.getElementById('postList');
    const noMatch = document.getElementById('noMatch');
    if (filter && list) {
      const cards = Array.from(list.querySelectorAll('.post-card'));
      filter.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.tag-btn') as HTMLElement | null;
        if (!btn) return;
        const tag = btn.getAttribute('data-tag') || '';
        filter.querySelectorAll('.tag-btn').forEach((b) => b.classList.toggle('is-active', b === btn));
        let shown = 0;
        cards.forEach((c) => {
          const tags = (c.getAttribute('data-tags') || '').split(',').filter(Boolean);
          const match = !tag || tags.includes(tag);
          (c as HTMLElement).hidden = !match;
          if (match) shown++;
        });
        if (noMatch) (noMatch as HTMLElement).hidden = shown !== 0;
      });
    }
  </script>
</Layout>

<style>
  .empty {
    text-align: center;
    color: var(--color-text-muted);
  }
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    max-width: 760px;
    margin: 0 auto 2rem;
  }
  .tag-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .tag-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .tag-btn.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
  .tag-c {
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }
  .tag-btn.is-active .tag-c {
    opacity: 0.9;
  }
  .post-card[hidden] {
    display: none;
  }
  .post-list {
    list-style: none;
    display: grid;
    gap: 1.5rem;
    max-width: 760px;
    margin-inline: auto;
  }
  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(91, 145, 53, 0.14);
  }
  .post-link {
    display: block;
    color: inherit;
  }
  .post-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .post-body {
    padding: 1.5rem 1.75rem;
  }
  .post-meta {
    display: flex;
    gap: 0.9rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .post-author::before {
    content: '✦ ';
    color: var(--color-accent);
  }
  .post-title {
    font-size: 1.3rem;
    margin-bottom: 0.6rem;
  }
  .post-excerpt {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 0.9rem;
  }
  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .post-tags li {
    font-size: 0.8rem;
    color: var(--color-accent-soft);
  }
</style>
