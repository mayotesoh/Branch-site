---
import Layout from '../layouts/Layout.astro';
import LineButton from '../components/LineButton.astro';
import EventModal from '../components/EventModal.astro';
import { getEvents } from '../lib/notion';

const base = import.meta.env.BASE_URL;
const joinUrl = `${base.replace(/\/$/, '')}/join`;

const TYPE_ICON: Record<string, string> = {
  定例会: '🗓️',
  スキルアップ講座: '📚',
  リーディング会: '🔮',
  ロープレ: '🃏',
  'マルシェ・イベント': '🎪',
  zoom解放日: '💻',
  ライブトーク: '🎙️',
};

const WD = ['日', '月', '火', '水', '木', '金', '土'];
const fmtPast = (iso: string) => {
  const d = new Date(iso);
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日（${WD[d.getDay()]}）`;
};

const allEvents = await getEvents();

// カレンダーへ渡す（日付ありのみ）
const calEvents = allEvents
  .filter((e) => e.date)
  .map((e) => ({
    id: e.pageId,
    name: e.name,
    type: e.type,
    date: e.date,
    end: e.end,
    url: e.url,
    accepting: e.accepting,
    memo: e.memo,
    body: e.body,
  }));

// 過去（今月より前）のイベントは一覧で下に表示
const monthStart = new Date();
monthStart.setDate(1);
monthStart.setHours(0, 0, 0, 0);
const past = allEvents
  .filter((e) => e.date && new Date(e.date).getTime() < monthStart.getTime())
  .reverse();
---

<Layout
  title="イベント｜Fortune Labo"
  description="Fortune Laboの定例会・スキルアップ講座・リーディング会・ロープレなど、開催予定をカレンダーでご案内します。"
>
  <section class="section">
    <div class="container">
      <h1 class="section-title">イベント</h1>
      <p class="section-lead">
        定例会・スキルアップ講座・リーディング会・ロープレなど、みんなで学び合う場をご案内します。<br />
        日付のイベントをタップすると詳細が開きます。
      </p>

      <!-- カレンダー -->
      <div class="cal" id="cal">
        <div class="cal-bar">
          <button class="cal-nav" id="calPrev" type="button" aria-label="前の月">‹</button>
          <h2 class="cal-title" id="calTitle" aria-live="polite"></h2>
          <button class="cal-nav" id="calNext" type="button" aria-label="次の月">›</button>
        </div>
        <div class="cal-wd">
          {WD.map((w, i) => (
            <span class={`cal-wd-cell ${i === 0 ? 'sun' : ''} ${i === 6 ? 'sat' : ''}`}>{w}</span>
          ))}
        </div>
        <div class="cal-grid" id="calGrid"></div>
        <p class="cal-hint">表示できるのは当月〜翌々月です。</p>
      </div>

      <!-- 過去のイベント -->
      {
        past.length > 0 && (
          <>
            <h2 class="ev-heading-past">これまでの開催</h2>
            <ul class="ev-past-list">
              {past.map((e) => (
                <li class="ev-past">
                  <span class="ev-past-date">{fmtPast(e.date)}</span>
                  <span class="ev-past-type">
                    {TYPE_ICON[e.type] ?? '✦'} {e.type}
                  </span>
                  <span class="ev-past-name">{e.name}</span>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <div class="ev-cta">
        <p>参加のご予約・ご相談は公式LINEから。会員の方は参加するとマイページにスタンプがたまります。</p>
        <div class="ev-cta-actions">
          <LineButton label="LINEで予約・相談する" />
          <a class="btn btn-ghost" href={joinUrl}>参加方法を見る</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 詳細モーダル（共用コンポーネント） -->
  <EventModal events={calEvents} />
</Layout>

<script define:vars={{ events: calEvents }} is:inline>
  const ICON = {
    '定例会': '🗓️', 'スキルアップ講座': '📚', 'リーディング会': '🔮',
    'ロープレ': '🃏', 'マルシェ・イベント': '🎪', 'zoom解放日': '💻', 'ライブトーク': '🎙️',
  };
  const esc = (s) =>
    String(s == null ? '' : s).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])
    );

  const grid = document.getElementById('calGrid');
  const titleEl = document.getElementById('calTitle');
  const prevBtn = document.getElementById('calPrev');
  const nextBtn = document.getElementById('calNext');

  // 日付キー（ローカル）→ イベント配列
  const byDay = {};
  events.forEach((e) => {
    const d = new Date(e.date);
    if (isNaN(d)) return;
    const k = `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
    (byDay[k] = byDay[k] || []).push(e);
  });
  // 同日内は開始時刻順
  Object.values(byDay).forEach((arr) =>
    arr.sort((a, b) => new Date(a.date) - new Date(b.date))
  );

  const now = new Date();
  const minKey = now.getFullYear() * 12 + now.getMonth();
  const maxKey = minKey + 2; // 当月・翌月・翌々月
  let viewY = now.getFullYear();
  let viewM = now.getMonth();

  const timeStr = (iso) => {
    if (!iso || !iso.includes('T')) return '';
    const d = new Date(iso);
    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  };

  function render() {
    const key = viewY * 12 + viewM;
    titleEl.textContent = `${viewY}年 ${viewM + 1}月`;
    prevBtn.disabled = key <= minKey;
    nextBtn.disabled = key >= maxKey;

    const first = new Date(viewY, viewM, 1);
    const startDow = first.getDay();
    const daysInMonth = new Date(viewY, viewM + 1, 0).getDate();
    const todayK = `${now.getFullYear()}-${now.getMonth()}-${now.getDate()}`;

    let html = '';
    for (let i = 0; i < startDow; i++) html += '<div class="cal-cell empty"></div>';
    for (let day = 1; day <= daysInMonth; day++) {
      const dow = new Date(viewY, viewM, day).getDay();
      const k = `${viewY}-${viewM}-${day}`;
      const evs = byDay[k] || [];
      const cls = ['cal-cell'];
      if (dow === 0) cls.push('sun');
      if (dow === 6) cls.push('sat');
      if (k === todayK) cls.push('today');
      if (evs.length) cls.push('has-ev');
      const chips = evs
        .map((e) => {
          const t = timeStr(e.date);
          return `<button class="cal-ev" type="button" data-ev-open="${esc(e.id)}">`
            + `<span class="cal-ev-ic">${ICON[e.type] || '✦'}</span>`
            + `<span class="cal-ev-nm">${t ? esc(t) + ' ' : ''}${esc(e.name)}</span></button>`;
        })
        .join('');
      html += `<div class="${cls.join(' ')}"><span class="cal-day">${day}</span>${chips}</div>`;
    }
    grid.innerHTML = html;
  }

  prevBtn.addEventListener('click', () => {
    if (viewY * 12 + viewM <= minKey) return;
    if (--viewM < 0) { viewM = 11; viewY--; }
    render();
  });
  nextBtn.addEventListener('click', () => {
    if (viewY * 12 + viewM >= maxKey) return;
    if (++viewM > 11) { viewM = 0; viewY++; }
    render();
  });

  // イベントのクリック（詳細表示）は共用の EventModal が [data-ev-open] を拾う

  render();
</script>

<style>
  /* カレンダー */
  .cal {
    max-width: 720px;
    margin: 0 auto 3rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.2rem;
  }
  .cal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .cal-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary-soft);
  }
  .cal-nav {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-text);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .cal-nav:hover:not(:disabled) {
    border-color: var(--color-primary);
    color: var(--color-primary-soft);
  }
  .cal-nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  .cal-wd {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }
  .cal-wd-cell.sun { color: #d05a5a; }
  .cal-wd-cell.sat { color: #5a76d0; }
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .cal-cell {
    min-height: 74px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.25rem;
    background: var(--color-bg-soft);
    display: flex;
    flex-direction: column;
    gap: 3px;
    overflow: hidden;
  }
  .cal-cell.empty {
    border: none;
    background: transparent;
  }
  .cal-day {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding-left: 0.15rem;
  }
  .cal-cell.sun .cal-day { color: #d05a5a; }
  .cal-cell.sat .cal-day { color: #5a76d0; }
  .cal-cell.today {
    border-color: var(--color-primary);
    background: rgba(46, 74, 138, 0.06);
  }
  .cal-cell.today .cal-day {
    color: var(--color-primary-soft);
    font-weight: 800;
  }
  .cal-ev {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    width: 100%;
    text-align: left;
    border: none;
    border-radius: 5px;
    padding: 2px 4px;
    cursor: pointer;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.68rem;
    line-height: 1.25;
  }
  .cal-ev:hover { filter: brightness(1.08); }
  .cal-ev-ic { flex-shrink: 0; }
  .cal-ev-nm {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cal-hint {
    margin-top: 0.9rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  /* 過去 */
  .ev-heading-past {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin: 2.5rem 0 1.2rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--color-border);
  }
  .ev-past-list {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    max-width: 720px;
    margin-inline: auto;
  }
  .ev-past {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    opacity: 0.85;
  }
  .ev-past-date { font-size: 0.85rem; color: var(--color-text-muted); }
  .ev-past-type { font-size: 0.78rem; color: var(--color-text-muted); }
  .ev-past-name { font-weight: 700; }

  /* CTA */
  .ev-cta {
    margin-top: 3rem;
    text-align: center;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
  }
  .ev-cta p {
    color: var(--color-text-muted);
    margin-bottom: 1.3rem;
    font-size: 0.92rem;
  }
  .ev-cta-actions {
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .cal { padding: 0.8rem; }
    .cal-cell { min-height: 60px; }
    .cal-ev-nm { display: none; }
    .cal-ev {
      justify-content: center;
      padding: 3px;
      font-size: 0.8rem;
    }
  }
</style>
