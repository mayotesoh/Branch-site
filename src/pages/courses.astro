---
import Layout from '../layouts/Layout.astro';
import LineButton from '../components/LineButton.astro';
import { getCourses, getAuthors } from '../lib/notion';

const base = import.meta.env.BASE_URL;
const joinUrl = `${base.replace(/\/$/, '')}/join`;
const courseUrl = (id: string) => `${base.replace(/\/$/, '')}/courses/${id}`;
const staffUrl = (id: string) => `${base.replace(/\/$/, '')}/staff/${id}`;
const yen = (n: number) => '¥' + n.toLocaleString('ja-JP');

const allCourses = await getCourses();
// 個別ページがある（公開）スタッフのidだけリンクする
const publicStaffIds = new Set((await getAuthors()).map((a) => a.id).filter(Boolean));

// カテゴリのアイコン（フィルタチップ用）
const CATEGORY_ICON: Record<string, string> = {
  '養成講座': '🎓',
  'キャリア・デビュー支援': '🧭',
  '体験講座（はじめての方へ）': '🌱',
  '練習会・ロールプレイ': '🃏',
  '集客・収益化・ビジネス': '💰',
  'メンタル・セルフケア': '🌿',
  'セミナー': '🎤',
  'その他': '✦',
};

// 全講座をフラットな1リストに（カテゴリ枠は設けず、タグ絞り込み＋全体で価格ソート）
const flat = allCourses.map((c) => ({
  id: c.pageId.replace(/-/g, ''),
  isCert: c.type === '養成講座',
  title: c.name,
  subtitle: c.courseName,
  desc: c.desc,
  instructors: c.instructors,
  arts: c.arts,
  period: c.period,
  method: c.method,
  afterCare: c.afterCare,
  note: c.note,
  categories: c.categories.length ? c.categories : ['その他'],
  memberPrice: c.memberPrice,
  nonMemberPrice: c.nonMemberPrice,
}));

// カテゴリ絞り込みタグ（全講座の全カテゴリの和集合・出現順）
const catSet: string[] = [];
for (const c of flat) for (const cat of c.categories) if (!catSet.includes(cat)) catSet.push(cat);
const filterGroups = catSet.map((name) => ({ key: name, label: name, icon: CATEGORY_ICON[name] ?? '✦' }));

// 占術フィルター（講座に設定された占術を出現順に）
const ART_ICON: Record<string, string> = {
  タロット: '🃏', 手相: '🖐️', 占星術: '🌟', 筆跡: '✍️',
  カード: '🎴', 数秘: '🔢', ルノルマン: '🎴', オラクル: '🔮',
};
const artSet: string[] = [];
for (const c of allCourses) for (const a of c.arts) if (!artSet.includes(a)) artSet.push(a);
const artFilters = artSet.map((a) => ({ key: a, label: a, icon: ART_ICON[a] ?? '🔮' }));
---

<Layout
  title="講座紹介｜Fortune Labo"
  description="Fortune Laboの養成講座とセッション・講座の一覧。プロデビューを目指す本格コースから、体験講座・練習会・収益化・メンタルケアまで幅広く用意しています。"
>
  <section class="section">
    <div class="container">
      <h1 class="section-title">講座紹介</h1>
      <p class="section-lead">
        学ぶ・練習する・稼ぐ・整える。<br />
        あなたのステージに合わせた講座とセッションを用意しています。
      </p>

      <!-- カテゴリで絞り込み -->
      {
        filterGroups.length > 1 && (
          <div class="filter-bar">
            <span class="filter-label">カテゴリ</span>
            <div class="course-filter" id="courseFilter">
              <button class="chip is-active" data-filter="all" type="button">すべて</button>
              {filterGroups.map((g) => (
                <button class="chip" data-filter={g.key} type="button">
                  <span class="chip-ico">{g.icon}</span>
                  {g.label}
                </button>
              ))}
            </div>
          </div>
        )
      }

      <!-- 占術で絞り込み -->
      {
        artFilters.length > 0 && (
          <div class="filter-bar">
            <span class="filter-label">占術</span>
            <div class="course-filter" id="artFilter">
              <button class="chip is-active" data-art="all" type="button">すべて</button>
              {artFilters.map((a) => (
                <button class="chip" data-art={a.key} type="button">
                  <span class="chip-ico">{a.icon}</span>
                  {a.label}
                </button>
              ))}
            </div>
          </div>
        )
      }

      <!-- 並び替え -->
      <div class="filter-bar">
        <span class="filter-label">並び替え</span>
        <div class="course-filter" id="sortBar">
          <button class="chip is-active" data-sort="default" type="button">おすすめ順</button>
          <button class="chip" data-sort="asc" type="button">価格の安い順</button>
          <button class="chip" data-sort="desc" type="button">価格の高い順</button>
        </div>
      </div>

      <p class="filter-empty" id="filterEmpty" hidden>
        該当する講座がありません。
      </p>

      <!-- 全講座（枠なし・タグ絞り込み＋全体で価格ソート） -->
      <div class="course-grid" id="courseGrid">
        {
          flat.map((c) => (
            <article
              class={`course-card${c.isCert ? ' is-cert' : ''}`}
              data-category={c.categories.join('|')}
              data-arts={c.arts.join('|')}
              data-price={c.memberPrice > 0 ? c.memberPrice : c.nonMemberPrice > 0 ? c.nonMemberPrice : ''}
            >
              <div class="course-head">
                {c.isCert && <span class="badge badge-cert">🎓 養成講座</span>}
                <p class="course-title">{c.title}</p>
              </div>
              {c.isCert && c.subtitle && <p class="course-sub">{c.subtitle}</p>}
              {c.desc && <p class="course-desc">{c.desc}</p>}
              <div class="meta">
                {c.arts.map((a) => (
                  <span class="badge badge-art">{ART_ICON[a] ?? '🔮'} {a}</span>
                ))}
                {c.instructors.map((teacher) =>
                  publicStaffIds.has(teacher.id) ? (
                    <a class="badge badge-teacher" href={staffUrl(teacher.id)}>👤 {teacher.name}</a>
                  ) : (
                    <span class="badge">👤 {teacher.name}</span>
                  )
                )}
                {c.period && <span class="badge">⏱ {c.period}</span>}
                {c.method && <span class="badge badge-method">{c.method}</span>}
                {c.afterCare && <span class="badge">2か月間 無料アフターフォロー付</span>}
              </div>
              {(c.memberPrice > 0 || c.nonMemberPrice > 0) && (
                <div class="price-row">
                  {c.memberPrice > 0 && <span class="price"><b>会員</b>{yen(c.memberPrice)}<span class="tax">税込</span></span>}
                  {c.nonMemberPrice > 0 && <span class="price"><b>一般</b>{yen(c.nonMemberPrice)}<span class="tax">税込</span></span>}
                </div>
              )}
              {c.note && <p class="course-note">※ {c.note}</p>}
              <a class="detail-link" href={courseUrl(c.id)}>詳細・お申し込み →</a>
            </article>
          ))
        }
      </div>

      <div class="courses-cta">
        <p>気になる講座はありましたか？ご予約・ご相談は公式LINEから。</p>
        <div class="courses-cta-actions">
          <LineButton label="LINEで予約・相談する" />
          <a class="btn btn-ghost" href={joinUrl}>参加方法を見る</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const catBar = document.getElementById('courseFilter');
    const artBar = document.getElementById('artFilter');
    const sortBar = document.getElementById('sortBar');
    const grid = document.getElementById('courseGrid');
    const emptyMsg = document.getElementById('filterEmpty');
    const cards = grid
      ? (Array.from(grid.querySelectorAll('.course-card')) as HTMLElement[])
      : [];
    const origOrder = cards.slice();
    let selCat = 'all';
    let selArt = 'all';

    function apply() {
      let visible = 0;
      cards.forEach((el) => {
        const cats = el.dataset.category ? el.dataset.category.split('|').filter(Boolean) : [];
        const arts = el.dataset.arts ? el.dataset.arts.split('|').filter(Boolean) : [];
        const catMatch = selCat === 'all' || cats.indexOf(selCat) !== -1;
        const artMatch = selArt === 'all' || arts.indexOf(selArt) !== -1;
        const show = catMatch && artMatch;
        el.hidden = !show;
        if (show) visible++;
      });
      if (emptyMsg) emptyMsg.hidden = visible > 0;
    }

    // 全体で価格ソート（価格未設定は常に末尾）
    function sortCourses(mode: string) {
      if (!grid) return;
      let items = origOrder.slice();
      if (mode === 'asc' || mode === 'desc') {
        const hasPrice = (el: HTMLElement) => el.dataset.price != null && el.dataset.price !== '';
        const priced = items.filter(hasPrice);
        const unpriced = items.filter((el) => !hasPrice(el));
        priced.sort(
          (a, b) =>
            (Number(a.dataset.price) - Number(b.dataset.price)) * (mode === 'desc' ? -1 : 1)
        );
        items = [...priced, ...unpriced];
      }
      items.forEach((el) => grid.appendChild(el));
    }

    function wire(bar: HTMLElement | null, key: 'cat' | 'art' | 'sort') {
      if (!bar) return;
      const chips = Array.from(bar.querySelectorAll('.chip')) as HTMLElement[];
      bar.addEventListener('click', (e) => {
        const chip = (e.target as HTMLElement).closest('.chip') as HTMLElement | null;
        if (!chip) return;
        chips.forEach((c) => c.classList.toggle('is-active', c === chip));
        if (key === 'sort') {
          sortCourses(chip.dataset.sort || 'default');
          return;
        }
        if (key === 'cat') selCat = chip.dataset.filter || 'all';
        else selArt = chip.dataset.art || 'all';
        apply();
      });
    }
    wire(catBar, 'cat');
    wire(artBar, 'art');
    wire(sortBar, 'sort');
  </script>
</Layout>

<style>
  /* 絞り込み */
  .filter-bar {
    max-width: 900px;
    margin: 0 auto 1.1rem;
  }
  .filter-bar:last-of-type {
    margin-bottom: 2.8rem;
  }
  .filter-label {
    display: block;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    letter-spacing: 0.04em;
  }
  .course-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    border-radius: 999px;
    padding: 0.45rem 1.05rem;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-soft);
  }
  .chip.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  .chip-ico {
    font-size: 0.95em;
  }
  .filter-empty {
    text-align: center;
    color: var(--color-text-muted);
    margin: 2rem 0 3rem;
  }

  .cat {
    margin-bottom: 3.5rem;
  }
  .cat-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-border);
  }
  .cat-icon {
    font-size: 2rem;
    line-height: 1;
  }
  .cat-name {
    font-size: 1.3rem;
    color: var(--color-primary-soft);
  }
  .cat-lead {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin-top: 0.2rem;
  }

  /* 共通メタ（担当・時間・提供方法） */
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .badge {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .badge-method {
    background: transparent;
  }
  .badge-art {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  a.badge-teacher {
    border-color: var(--color-primary);
    color: var(--color-primary-soft);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  a.badge-teacher:hover {
    background: var(--color-primary);
    color: #fff;
  }
  .price-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.7rem;
  }
  .price {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.3rem 0.7rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary-soft);
  }
  .price b {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    margin-right: 0.4rem;
    font-weight: 700;
  }
  .price .tax {
    font-size: 0.62rem;
    color: var(--color-text-muted);
    margin-left: 0.3rem;
    font-weight: 600;
  }
  .badge-note {
    background: transparent;
    border-color: var(--color-accent);
    color: var(--color-accent-soft);
  }

  /* フラット化した全講座グリッド */
  #courseGrid { margin-top: 0.5rem; }
  .course-card[hidden] { display: none; }
  .course-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .course-card.is-cert { border-left-color: var(--color-accent); }
  .badge-cert {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
    font-weight: 700;
  }
  .course-sub {
    color: var(--color-primary-soft);
    font-size: 0.88rem;
    margin-top: 0.3rem;
  }

  /* 養成講座カード */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }
  .cert-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .cert-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .cert-name {
    font-size: 1.25rem;
  }
  .cert-course {
    color: var(--color-primary-soft);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .cert-target {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin-top: 0.8rem;
  }
  .curriculum {
    margin-top: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 0.8rem;
  }
  .curriculum summary {
    cursor: pointer;
    color: var(--color-primary-soft);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .curriculum ul {
    margin: 0.8rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .cert-extra {
    margin-top: 0.8rem;
    color: var(--color-accent-soft);
    font-size: 0.85rem;
  }

  /* セッション・講座カード */
  .course-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }
  .course-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 10px;
    padding: 1.2rem 1.3rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .course-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .course-title {
    font-weight: 700;
    line-height: 1.5;
    font-size: 1.02rem;
  }
  .course-desc {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin-top: 0.6rem;
    flex-grow: 1;
  }
  .course-note {
    color: var(--color-accent-soft);
    font-size: 0.8rem;
    margin-top: 0.6rem;
  }

  .detail-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-primary-soft);
  }
  .detail-link:hover {
    color: var(--color-primary);
  }

  .courses-cta {
    text-align: center;
    margin-top: 1rem;
    padding: 2.5rem 1rem;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .courses-cta p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .courses-cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
