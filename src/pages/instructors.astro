---

<Layout
  title="スタッフ紹介｜Fortune Labo"
  description="Fortune Labo のスタッフ紹介ページです。"
>
  <section class="section">
    <div class="container">
      <h1 class="section-title">スタッフ紹介</h1>
      <p class="section-lead">Fortune Labo を運営し、あなたの学びを支えるスタッフです。</p>

      {
        members.length === 0 ? (
          <p class="empty">現在、公開中の運営メンバーはいません。</p>
        ) : (
          <div class="instructor-list">
            {members.map((m) => (
              <article class="instructor">
                <div class="photo">
                  {m.image ? (
                    <img src={m.image} alt={`${m.name}の写真`} loading="lazy" />
                  ) : (
                    <div class="photo-fallback" aria-hidden="true">
                      {m.name.trim().charAt(0)}
                    </div>
                  )}
                </div>
                <div class="profile">
                  <h2 class="name">
                    {m.name}
                    {m.kana && <span class="kana">{m.kana}</span>}
                  </h2>
                  {m.role && <p class="role">{m.role}</p>}

                  {m.arts.length > 0 && (
                    <>
                      <h3 class="arts-title">主な占術・専門</h3>
                      <ul class="arts">
                        {m.arts.map((a) => (
                          <li>{a}</li>
                        ))}
                      </ul>
                    </>
                  )}

                  <div class="member-links">
                    {m.id && (
                      <a class="blog-link" href={blogUrl(m.id)}>ブログを見る →</a>
                    )}
                    {SNS.some((s) => (m.sns as any)[s.key]) && (
                      <div class="sns-row">
                        {SNS.map((s) =>
                          (m.sns as any)[s.key] ? (
                            <a
                              class={`sns sns-${s.key}`}
                              href={(m.sns as any)[s.key]}
                              target="_blank"
                              rel="noopener noreferrer"
                              aria-label={`${m.name}の${s.label}`}
                            >
                              <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d={s.path} />
                              </svg>
                            </a>
                          ) : null
                        )}
                      </div>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .instructor-list {
    display: grid;
    gap: 2.5rem;
    max-width: 880px;
    margin-inline: auto;
  }
  .empty {
    text-align: center;
    color: var(--color-text-muted);
    margin-top: 2rem;
  }
  .instructor {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
    align-items: start;
  }
  .photo img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    display: block;
  }
  .photo-fallback {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    color: var(--color-primary-soft);
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 700;
  }
  .name {
    font-size: 1.6rem;
    margin-bottom: 0.4rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .kana {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .role {
    color: var(--color-primary-soft);
    margin-bottom: 1.5rem;
  }
  .arts-title {
    font-size: 1.05rem;
    color: var(--color-accent-soft);
    margin-bottom: 0.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .arts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .arts li {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.85rem;
    color: var(--color-text);
  }

  /* ブログ導線 & SNS */
  .member-links {
    margin-top: 1.4rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem 1.2rem;
  }
  .blog-link {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-primary-soft);
  }
  .blog-link:hover { color: var(--color-primary); }
  .sns-row { display: flex; gap: 0.5rem; }
  .sns {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition: transform 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .sns svg { width: 16px; height: 16px; fill: currentColor; }
  .sns:hover { transform: translateY(-2px); }
  .sns-instagram:hover { color: #e1306c; border-color: #e1306c; }
  .sns-x:hover { color: #000; border-color: #000; }
  .sns-facebook:hover { color: #1877f2; border-color: #1877f2; }
  .sns-tiktok:hover { color: #010101; border-color: #010101; }
  .sns-youtube:hover { color: #ff0000; border-color: #ff0000; }

  @media (max-width: 680px) {
    .instructor {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem;
    }
    .photo {
      max-width: 220px;
      margin-inline: auto;
    }
  }
</style>
