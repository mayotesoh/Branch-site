---
import Layout from '../layouts/Layout.astro';
import { getAuthors } from '../lib/notion';

// Notion「講師DB」の公開メンバーを参照（公開チェックのある人だけ表示）
const members = await getAuthors();
---

<Layout
  title="運営メンバー｜Fortune Labo"
  description="Fortune Labo を運営するメンバーの紹介ページです。"
>
  <section class="section">
    <div class="container">
      <h1 class="section-title">運営メンバー</h1>
      <p class="section-lead">Fortune Labo を運営し、あなたの学びを支えるメンバーです。</p>

      {
        members.length === 0 ? (
          <p class="empty">現在、公開中の運営メンバーはいません。</p>
        ) : (
          <div class="instructor-list">
            {members.map((m) => (
              <article class="instructor">
                <div class="photo">
                  {m.image ? (
                    <img src={m.image} alt={`${m.name}の写真`} loading="lazy" />
                  ) : (
                    <div class="photo-fallback" aria-hidden="true">
                      {m.name.trim().charAt(0)}
                    </div>
                  )}
                </div>
                <div class="profile">
                  <h2 class="name">
                    {m.name}
                    {m.kana && <span class="kana">{m.kana}</span>}
                  </h2>
                  {m.role && <p class="role">{m.role}</p>}

                  {m.arts.length > 0 && (
                    <>
                      <h3 class="arts-title">主な占術・専門</h3>
                      <ul class="arts">
                        {m.arts.map((a) => (
                          <li>{a}</li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .instructor-list {
    display: grid;
    gap: 2.5rem;
    max-width: 880px;
    margin-inline: auto;
  }
  .empty {
    text-align: center;
    color: var(--color-text-muted);
    margin-top: 2rem;
  }
  .instructor {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
    align-items: start;
  }
  .photo img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    display: block;
  }
  .photo-fallback {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    color: var(--color-primary-soft);
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 700;
  }
  .name {
    font-size: 1.6rem;
    margin-bottom: 0.4rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .kana {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .role {
    color: var(--color-primary-soft);
    margin-bottom: 1.5rem;
  }
  .arts-title {
    font-size: 1.05rem;
    color: var(--color-accent-soft);
    margin-bottom: 0.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .arts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .arts li {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.85rem;
    color: var(--color-text);
  }

  @media (max-width: 680px) {
    .instructor {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem;
    }
    .photo {
      max-width: 220px;
      margin-inline: auto;
    }
  }
</style>
